---
import '../index.css';
import '../stylesheet.css';

interface Props {
  title?: string;
  styles?: string;
}

const { title = 'Janaka Brahmanage', styles = '' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-CDF5GWTFCX"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-CDF5GWTFCX');
    </script>

    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <title>{title}</title>
    <meta name="author" content="Janaka Brahmanage">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" href="/images/favicon/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v6.5.0/css/all.css">
    <Fragment set:html={styles} />
  </head>
  <body>
    <slot />
  </body>
</html>
